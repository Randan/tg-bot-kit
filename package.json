{
  "name": "@randan/tg-bot-kit",
  "version": "1.0.1",
  "description": "Shared runtime plumbing for NestJS Telegram bots: env config, /health, /diag, command menu, admin alerts, timeouts, retries, pollers and a watchdog",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Randan/tg-bot-kit.git"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@randan/tg-logger": "^1.1.0",
    "nestjs-telegraf": "^2.0.0",
    "telegraf": "^4.0.0"
  },
  "keywords": [
    "nestjs",
    "telegram",
    "bot",
    "health",
    "diagnostics"
  ],
  "license": "MIT",
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "watchman": false,
    "coverageDirectory": "../coverage",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "branches": 80,
        "functions": 90,
        "statements": 90
      }
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^10.4.22",
    "@randan/tg-logger": "^1.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.7.0",
    "nestjs-telegraf": "^2.9.1",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0",
    "telegraf": "^4.16.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  }
}
